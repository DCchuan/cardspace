        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
        "not": {
          "enum": [
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/action"
      },
      "maxProperties": 50
    },
    "view": {
      "$ref": "#/$defs/node"
    }
