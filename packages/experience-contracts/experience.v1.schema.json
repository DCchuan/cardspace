{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardspace.local/contracts/experience.v1.schema.json",
  "title": "CardSpace Experience v1",
  "description": "固定规范；节点/类型/来源/图/表达式与资源限制由维护者静态语义校验器补充。不执行生成脚本。",
  "type": "object",
  "properties": {
    "version": {
      "const": "experience.v1"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "mode": {
      "enum": [
        "explainer",
        "prototype"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "maxItems": 20,
      "minItems": 0
    },
    "state": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
        "not": {
          "enum": [
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      },
      "maxProperties": 30
    },
    "datasets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
